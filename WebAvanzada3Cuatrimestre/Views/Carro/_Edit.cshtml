@model WebAvanzada3Cuatrimestre.Application.Dtos.CarroDto

<div class="modal fade" id="modalEditarCarro" tabindex="-1" aria-labelledby="modalEditarCarroLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered vehicle-modal-dialog">
        <div class="modal-content vehicle-modal">
            <form id="formEditarCarro" asp-controller="Carro" asp-action="ActualizarCarro" method="post">
                <div class="modal-header vehicle-modal-header">
                    <div class="vehicle-modal-heading">
                        <span class="vehicle-modal-icon"><i class="bi bi-pencil-square"></i></span>
                        <div>
                            <span class="vehicle-modal-eyebrow">ACTUALIZAR REGISTRO</span>
                            <h5 class="modal-title" id="modalEditarCarroLabel">Editar vehículo</h5>
                            <p class="vehicle-modal-subtitle">Revisa y actualiza la información del vehículo.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body vehicle-modal-body">
                    <div id="mensajeEditarCarro" class="alert d-none" role="alert"></div>
                    <input asp-for="Id" type="hidden" />
                    <div class="vehicle-field mb-3">
                        <label asp-for="Placa" class="form-label">Placa</label>
                        <div class="vehicle-control">
                            <i class="bi bi-card-text" aria-hidden="true"></i>
                            <input asp-for="Placa" class="form-control" placeholder="Ej. ABC-123" autocomplete="off" required />
                        </div>
                        <span asp-validation-for="Placa" class="text-danger"></span>
                    </div>
                    <div class="vehicle-field mb-3">
                        <label asp-for="Marca" class="form-label">Marca</label>
                        <div class="vehicle-control">
                            <i class="bi bi-car-front" aria-hidden="true"></i>
                            <input asp-for="Marca" class="form-control" placeholder="Ej. Toyota" required />
                        </div>
                        <span asp-validation-for="Marca" class="text-danger"></span>
                    </div>
                    <div class="vehicle-field mb-3">
                        <label asp-for="Fkduenno" class="form-label">Dueño</label>
                        <div class="vehicle-control">
                            <i class="bi bi-person" aria-hidden="true"></i>
                            <select asp-for="Fkduenno" class="form-select" required>
                            <option value="">Seleccione un dueño</option>
                            @if (ViewBag.Duennos != null)
                            {
                                @foreach (var duenno in ViewBag.Duennos) //ViewBag, ViewData
                                {
                                    <option value="@duenno.Id">@duenno.Nombre @duenno.Apellido1 @duenno.Apellido2</option>
                                }
                            }
                            </select>
                        </div>
                        <span asp-validation-for="Fkduenno" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer vehicle-modal-footer">
                    <button type="button" class="btn btn-modal-cancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-modal-primary" id="btnEditarCarro"><i class="bi bi-check2"></i> Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
